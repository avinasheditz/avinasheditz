{
  "entities": {
    "project": {
      "title": "Project",
      "description": "A video editing project/order",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "assigned", "in-progress", "completed"] },
        "clientId": { "type": "string" },
        "editorId": { "type": "string" },
        "budget": { "type": "number" },
        "currency": { "type": "string" },
        "requirements": { "type": "string" },
        "finalFileUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "video": {
      "title": "Video",
      "description": "A showcase or library video",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "thumbnail": { "type": "string" },
        "tags": { "type": "array" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published", "processing"] },
        "views": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "editor": {
      "title": "Editor",
      "description": "Staff member who edits videos",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "busy", "offline"] },
        "completedTasks": { "type": "number" },
        "rating": { "type": "number" }
      }
    },
    "pricing": {
      "title": "Pricing Setting",
      "description": "Multi-currency pricing configuration",
      "type": "object",
      "properties": {
        "tier": { "type": "string", "enum": ["basic", "pro", "prime"] },
        "amounts": { "type": "object" },
        "activeCurrency": { "type": "string" }
      }
    },
    "settings": {
      "title": "App Settings",
      "description": "Global appearance and content settings",
      "type": "object",
      "properties": {
        "websiteName": { "type": "string" },
        "tagline": { "type": "string" },
        "logoUrl": { "type": "string" },
        "primaryColor": { "type": "string" },
        "darkMode": { "type": "boolean" },
        "contactEmail": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/projects/{projectId}": { "schema": "project", "description": "Client orders" },
    "/videos/{videoId}": { "schema": "video", "description": "Video library" },
    "/editors/{editorId}": { "schema": "editor", "description": "Team members" },
    "/pricing/{tierId}": { "schema": "pricing", "description": "Pricing tiers" },
    "/settings/global": { "schema": "settings", "description": "Store settings" }
  }
}
