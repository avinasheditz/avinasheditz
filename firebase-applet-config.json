import { motion } from 'motion/react';
import { Settings, Palette, Globe, Shield, Bell, Save, RefreshCcw, Image, Type, Phone, Mail } from 'lucide-react';
import { useState, useEffect } from 'react';
import { doc, getDoc, setDoc, serverTimestamp } from 'firebase/firestore';
import { db } from '@/src/lib/firebase';
import { cn } from '@/src/lib/utils';

export function SettingsPanel() {
  const [config, setConfig] = useState({
    websiteName: 'A Studio',
    tagline: 'Crafting Cinematic Visual Stories',
    primaryColor: '#3b82f6',
    contactEmail: 'contact@astudio.com',
    whatsappNumber: '+91 000 000 0000',
    logoUrl: '',
    bgOverlayOpacity: 0.1,
  });
  const [saving, setSaving] = useState(false);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchSettings = async () => {
      const docRef = doc(db, 'settings', 'global');
      const docSnap = await getDoc(docRef);
      if (docSnap.exists()) {
        setConfig(docSnap.data() as any);
      }
      setLoading(false);
    };
    fetchSettings();
  }, []);

  const handleSave = async () => {
    setSaving(true);
    await setDoc(doc(db, 'settings', 'global'), {
      ...config,
      updatedAt: serverTimestamp()
    });
    setSaving(false);
    alert('Settings synced successfully!');
  };

  if (loading) return null;

  return (
    <div className="space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-500">
      <div className="flex items-center justify-between">
        <div>
          <h2 className="text-4xl font-heading italic text-white mb-2">Global Settings</h2>
          <p className="text-white/40">Manage identity, appearance, and core configurations.</p>
        </div>
        <button 
          onClick={handleSave}
          disabled={saving}
          className="bg-white text-black px-8 py-4 rounded-2xl font-bold uppercase tracking-widest text-[10px] flex items-center gap-2 hover:bg-white/90 transition-all disabled:opacity-50"
        >
          {saving ? <RefreshCcw className="w-4 h-4 animate-spin" /> : <Save className="w-4 h-4" />}
          Sync Core Settings
        </button>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div className="lg:col-span-2 space-y-8">
          {/* Identity Section */}
          <div className="liquid-glass rounded-[32px] p-10 border border-white/5 space-y-8">
             <div className="flex items-center gap-3 text-white/40">
                <Type className="w-5 h-5" />
                <h3 className="font-heading italic text-xl text-white">Brand Identity</h3>
             </div>
             <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div className="space-y-2">
                  <label className="text-[10px] uppercase font-bold text-white/40 tracking-[0.2em] ml-1">Website Name</label>
                  <input 
                    value={config.websiteName}
                    onChange={(e) => setConfig({...config, websiteName: e.target.value})}
                    className="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-sm focus:border-white/30 outline-none transition-all"
                  />
                </div>
                <div className="space-y-2">
                  <label className="text-[10px] uppercase font-bold text-white/40 tracking-[0.2em] ml-1">Contact Email</label>
                  <input 
                    value={config.contactEmail}
                    onChange={(e) => setConfig({...config, contactEmail: e.target.value})}
                    className="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-sm focus:border-white/30 outline-none transition-all"
                  />
                </div>
             </div>
             <div className="space-y-2">
                <label className="text-[10px] uppercase font-bold text-white/40 tracking-[0.2em] ml-1">Tagline</label>
                <input 
                  value={config.tagline}
                  onChange={(e) => setConfig({...config, tagline: e.target.value})}
                  className="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-sm focus:border-white/30 outline-none transition-all"
                />
             </div>
          </div>

          {/* Appearance Section */}
          <div className="liquid-glass rounded-[32px] p-10 border border-white/5 space-y-8">
             <div className="flex items-center gap-3 text-white/40">
                <Palette className="w-5 h-5" />
                <h3 className="font-heading italic text-xl text-white">Visual Design</h3>
             </div>
             <div className="grid grid-cols-1 md:grid-cols-2 gap-10">
                <div className="space-y-4">
                   <label className="text-[10px] uppercase font-bold text-white/40 tracking-[0.2em] ml-1">Primary Color</label>
                   <div className="flex items-center gap-4">
                      <div 
                        className="w-14 h-14 rounded-2xl border-4 border-white/5 shadow-xl transition-transform hover:scale-110" 
                        style={{ backgroundColor: config.primaryColor }}
                      />
                      <input 
                        type="color"
                        value={config.primaryColor}
                        onChange={(e) => setConfig({...config, primaryColor: e.target.value})}
                        className="flex-1 bg-white/5 border border-white/10 rounded-xl px-4 py-2 text-sm outline-none cursor-pointer h-14"
                      />
                   </div>
                </div>
                <div className="space-y-4">
                   <label className="text-[10px] uppercase font-bold text-white/40 tracking-[0.2em] ml-1">Overlay Opacity</label>
                   <div className="flex items-center gap-6">
                      <input 
                        type="range"
                        min="0"
                        max="1"
                        step="0.05"
                        value={config.bgOverlayOpacity}
                        onChange={(e) => setConfig({...config, bgOverlayOpacity: Number(e.target.value)})}
                        className="flex-1 accent-white"
                      />
                      <span className="text-xl font-mono font-bold text-white/60 min-w-[3rem]">
                        {(config.bgOverlayOpacity * 100).toFixed(0)}%
                      </span>
                   </div>
                </div>
             </div>
          </div>
        </div>

        <div className="space-y-8">
           {/* Live Preview Card */}
           <div className="liquid-glass rounded-[32px] p-8 border border-white/5 space-y-6 sticky top-8 overflow-hidden relative">
              <div className="absolute top-0 right-0 p-4">
                <Shield className="w-10 h-10 text-white/[0.02]" />
              </div>
              <h3 className="text-xl font-heading italic text-white/60">Real-time Preview</h3>
              <div className="aspect-[4/3] rounded-2xl bg-black border border-white/10 flex flex-col items-center justify-center p-6 text-center shadow-inner">
                 <div className="w-12 h-12 bg-white rounded-xl mb-4 flex items-center justify-center">
                   <span className="text-black font-heading italic text-xl font-bold">A</span>
                 </div>
                 <h4 className="text-xl font-heading italic mb-1" style={{ color: config.primaryColor }}>{config.websiteName}</h4>
                 <p className="text-[10px] text-white/30 uppercase tracking-[0.3em] font-bold">{config.tagline}</p>
                 
                 <button className="mt-8 px-6 py-2 rounded-full text-[10px] uppercase font-bold tracking-widest transition-all" style={{ backgroundColor: config.primaryColor }}>
                   Get Started
                 </button>
              </div>
              <p className="text-xs text-white/20 italic leading-relaxed text-center px-4">
                This preview reflects how your changes will appear on the landing page public header and hero section.
              </p>
           </div>
        </div>
      </div>
    </div>
  );
}
