import { motion } from 'motion/react';
import { Users, UserPlus, Search, MoreVertical, Star, Activity, UserMinus, Shield, ShieldAlert, Mail } from 'lucide-react';
import { useState, useEffect } from 'react';
import { collection, query, onSnapshot, addDoc, deleteDoc, doc, updateDoc, serverTimestamp } from 'firebase/firestore';
import { db } from '@/src/lib/firebase';
import { cn } from '@/src/lib/utils';

export function EditorManager() {
  const [editors, setEditors] = useState<any[]>([]);
  const [isAdding, setIsAdding] = useState(false);
  const [newEditor, setNewEditor] = useState({ fullName: '', email: '', role: 'editor', status: 'offline' });

  useEffect(() => {
    const q = query(collection(db, 'editors'));
    return onSnapshot(q, (snapshot) => {
      setEditors(snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })));
    });
  }, []);

  const handleAddEditor = async (e: React.FormEvent) => {
    e.preventDefault();
    await addDoc(collection(db, 'editors'), {
      ...newEditor,
      completedTasks: 0,
      rating: 5.0,
      createdAt: serverTimestamp()
    });
    setNewEditor({ fullName: '', email: '', role: 'editor', status: 'offline' });
    setIsAdding(false);
  };

  return (
    <div className="space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-500">
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <h2 className="text-4xl font-heading italic text-white mb-2">Team Management</h2>
          <p className="text-white/40">Manage your editors and track their real-time performance.</p>
        </div>
        <button 
          onClick={() => setIsAdding(true)}
          className="bg-white text-black px-6 py-4 rounded-2xl font-bold uppercase tracking-widest text-[10px] flex items-center gap-2 hover:bg-white/90 transition-all shadow-xl shadow-white/10"
        >
          <UserPlus className="w-4 h-4" />
          Onboard Editor
        </button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {editors.map((editor) => (
          <div key={editor.id} className="liquid-glass rounded-[32px] p-8 border border-white/5 relative group hover:bg-white/[0.03] transition-all">
            <div className="flex items-start justify-between mb-8">
               <div className="relative">
                  <div className="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center border border-white/10">
                    <span className="text-2xl font-heading italic">{editor.fullName.charAt(0)}</span>
                  </div>
                  <div className={cn(
                    "absolute -bottom-1 -right-1 w-5 h-5 rounded-full border-4 border-[#0a0a0b]",
                    editor.status === 'online' ? "bg-emerald-500" : editor.status === 'busy' ? "bg-amber-500" : "bg-white/10"
                  )} />
               </div>
               <div className="flex gap-2">
                 <div className="flex items-center gap-1 bg-white/5 px-3 py-1 rounded-full border border-white/5">
                   <Star className="w-3 h-3 text-amber-500 fill-amber-500" />
                   <span className="text-[10px] font-bold">{editor.rating?.toFixed(1)}</span>
                 </div>
                 <button className="p-2 text-white/20 hover:text-white transition-colors">
                   <MoreVertical className="w-4 h-4" />
                 </button>
               </div>
            </div>

            <div className="space-y-4 mb-8">
               <div>
                 <h3 className="text-2xl font-heading italic text-white">{editor.fullName}</h3>
                 <p className="text-white/40 text-xs flex items-center gap-2">
                    <Mail className="w-3 h-3" />
                    {editor.email}
                 </p>
               </div>
               <div className="flex items-center gap-2">
                  <span className={cn(
                    "px-3 py-1 rounded-lg text-[10px] font-bold uppercase tracking-widest border",
                    editor.role === 'admin' ? "bg-purple-500/10 text-purple-500 border-purple-500/20" : "bg-blue-500/10 text-blue-500 border-blue-500/20"
                  )}>
                    {editor.role === 'admin' ? <Shield className="w-3 h-3 inline mr-1" /> : <Activity className="w-3 h-3 inline mr-1" />}
                    {editor.role}
                  </span>
                  <span className="bg-white/5 text-white/40 px-3 py-1 rounded-lg text-[10px] font-bold uppercase tracking-widest border border-white/5">
                    {editor.completedTasks} Tasks
                  </span>
               </div>
            </div>

            <div className="flex gap-2 pt-6 border-t border-white/5">
               <button className="flex-1 py-3 bg-white/5 hover:bg-white/10 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all">
                  Assign Task
               </button>
               <button className="flex-1 py-3 bg-rose-500/10 text-rose-500 hover:bg-rose-500/20 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all">
                  Deactivate
               </button>
            </div>
          </div>
        ))}
      </div>

      {isAdding && (
        <div className="fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center z-50 p-6">
          <motion.div 
            initial={{ opacity: 0, scale: 0.95, y: 20 }}
            animate={{ opacity: 1, scale: 1, y: 0 }}
            className="liquid-glass-strong w-full max-w-md rounded-[40px] p-10 border border-white/10 shadow-2xl relative"
          >
            <div className="absolute top-8 right-8">
               <button onClick={() => setIsAdding(false)} className="text-white/20 hover:text-white transition-colors">
                 <UserMinus className="w-6 h-6" />
               </button>
            </div>
            <h2 className="text-3xl font-heading italic mb-2 text-white">New Editor</h2>
            <p className="text-sm text-white/40 mb-10">Set up credentials for your new team member.</p>
            
            <form onSubmit={handleAddEditor} className="space-y-6">
              <div className="space-y-2">
                <label className="text-[10px] uppercase font-bold text-white/40 tracking-[0.2em] ml-1">Full Name</label>
                <input 
                  required
                  value={newEditor.fullName}
                  onChange={(e) => setNewEditor({...newEditor, fullName: e.target.value})}
                  className="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-sm focus:border-blue-500 outline-none transition-all"
                  placeholder="e.g. Alex Rivera"
                />
              </div>
              <div className="space-y-2">
                <label className="text-[10px] uppercase font-bold text-white/40 tracking-[0.2em] ml-1">Work Email</label>
                <input 
                  required
                  type="email"
                  value={newEditor.email}
                  onChange={(e) => setNewEditor({...newEditor, email: e.target.value})}
                  className="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-sm focus:border-blue-500 outline-none transition-all"
                  placeholder="editor@studio.com"
                />
              </div>
              <div className="space-y-2">
                <label className="text-[10px] uppercase font-bold text-white/40 tracking-[0.2em] ml-1">Default Role</label>
                <select 
                  value={newEditor.role}
                  onChange={(e) => setNewEditor({...newEditor, role: e.target.value})}
                  className="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-sm focus:border-blue-500 outline-none transition-all"
                >
                  <option value="editor">Video Editor</option>
                  <option value="vfx">VFX Artist</option>
                  <option value="admin">System Admin</option>
                </select>
              </div>
              <button 
                type="submit"
                className="w-full bg-white text-black font-bold uppercase tracking-widest text-[10px] py-5 rounded-2xl hover:scale-[1.02] active:scale-[0.98] transition-all mt-4"
              >
                Onboard Editor
              </button>
            </form>
          </motion.div>
        </div>
      )}
    </div>
  );
}
