import { motion } from 'motion/react';
import { Tag, Plus, Trash2, Edit2, Hash, Hash as CategoryIcon } from 'lucide-react';
import { useState, useEffect } from 'react';
import { collection, query, onSnapshot, addDoc, deleteDoc, doc, updateDoc, serverTimestamp } from 'firebase/firestore';
import { db } from '@/src/lib/firebase';
import { cn } from '@/src/lib/utils';

export function CategoryManager() {
  const [categories, setCategories] = useState<any[]>([]);
  const [tags, setTags] = useState<any[]>([]);
  const [newCat, setNewCat] = useState('');
  const [newTag, setNewTag] = useState('');

  useEffect(() => {
    const unsubCat = onSnapshot(collection(db, 'categories'), (snapshot) => {
      setCategories(snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })));
    });
    const unsubTags = onSnapshot(collection(db, 'tags'), (snapshot) => {
      setTags(snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })));
    });
    return () => { unsubCat(); unsubTags(); };
  }, []);

  const handleAddCat = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newCat.trim()) return;
    await addDoc(collection(db, 'categories'), { name: newCat, createdAt: serverTimestamp() });
    setNewCat('');
  };

  const handleAddTag = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newTag.trim()) return;
    await addDoc(collection(db, 'tags'), { name: newTag, createdAt: serverTimestamp() });
    setNewTag('');
  };

  const handleDelete = async (collectionName: string, id: string) => {
    if (confirm('Are you sure?')) {
      await deleteDoc(doc(db, collectionName, id));
    }
  };

  return (
    <div className="grid grid-cols-1 lg:grid-cols-2 gap-10 animate-in fade-in slide-in-from-bottom-4 duration-500">
      {/* Categories */}
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-heading italic text-white mb-2">Categories</h2>
          <p className="text-white/40 text-sm">Organize projects into major service groups.</p>
        </div>
        
        <form onSubmit={handleAddCat} className="flex gap-2">
           <input 
             value={newCat}
             onChange={(e) => setNewCat(e.target.value)}
             placeholder="New Category (e.g. Wedding Edits)"
             className="flex-1 bg-white/5 border border-white/10 rounded-xl px-5 py-3 text-sm focus:border-white/30 outline-none transition-all"
           />
           <button className="bg-white text-black px-6 py-3 rounded-xl font-bold uppercase tracking-widest text-[10px] hover:bg-white/90">Add</button>
        </form>

        <div className="grid grid-cols-1 gap-3">
          {categories.map((cat) => (
            <div key={cat.id} className="liquid-glass border border-white/5 rounded-2xl p-4 flex items-center justify-between group">
               <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center">
                    <CategoryIcon className="w-5 h-5 text-white/20" />
                  </div>
                  <span className="font-heading italic text-lg">{cat.name}</span>
               </div>
               <button onClick={() => handleDelete('categories', cat.id)} className="p-2 opacity-0 group-hover:opacity-100 text-rose-500/40 hover:text-rose-500 transition-all">
                  <Trash2 className="w-4 h-4" />
               </button>
            </div>
          ))}
        </div>
      </div>

      {/* Tags */}
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-heading italic text-white mb-2">Meta Tags</h2>
          <p className="text-white/40 text-sm">Enable granular search and filtering.</p>
        </div>

        <form onSubmit={handleAddTag} className="flex gap-2">
           <input 
             value={newTag}
             onChange={(e) => setNewTag(e.target.value)}
             placeholder="New Tag (e.g. cinematic, 4k, vfx)"
             className="flex-1 bg-white/5 border border-white/10 rounded-xl px-5 py-3 text-sm focus:border-white/30 outline-none transition-all"
           />
           <button className="bg-blue-500 text-white px-6 py-3 rounded-xl font-bold uppercase tracking-widest text-[10px] hover:bg-blue-600">Add</button>
        </form>

        <div className="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <div key={tag.id} className="liquid-glass border border-white/5 rounded-full px-4 py-2 flex items-center gap-2 group hover:border-white/20 transition-all">
               <Hash className="w-3 h-3 text-white/20" />
               <span className="text-xs font-bold text-white/60">{tag.name}</span>
               <button onClick={() => handleDelete('tags', tag.id)} className="ml-2 text-rose-500/0 group-hover:text-rose-500 transition-all">
                  <Trash2 className="w-3 h-3" />
               </button>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}
